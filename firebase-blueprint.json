{
  "entities": {
    "Fest": {
      "title": "Fest",
      "description": "College festival master configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "collegeName": { "type": "string", "maxLength": 150 },
        "edition": { "type": "string", "maxLength": 50 },
        "startDate": { "type": "string", "maxLength": 20 },
        "endDate": { "type": "string", "maxLength": 20 },
        "totalBudget": { "type": "number" },
        "description": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["draft", "planning", "live", "concluded"] },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 200 },
        "committee": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "collegeName", "startDate", "endDate", "totalBudget", "status", "ownerId"]
    },
    "Venue": {
      "title": "Venue",
      "description": "Campus venue available for fest activities",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "festId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 150 },
        "capacity": { "type": "number" },
        "availableStart": { "type": "string", "maxLength": 10 },
        "availableEnd": { "type": "string", "maxLength": 10 },
        "pricingPerHour": { "type": "number" },
        "facilities": { "type": "array" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "festId", "name", "location", "capacity", "availableStart", "availableEnd", "ownerId"]
    },
    "Event": {
      "title": "Event",
      "description": "College fest event or competition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "festId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 50 },
        "department": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "durationMinutes": { "type": "number" },
        "expectedParticipants": { "type": "number" },
        "estimatedCost": { "type": "number" },
        "venueId": { "type": "string", "maxLength": 128 },
        "venueName": { "type": "string", "maxLength": 100 },
        "requiredResources": { "type": "array" },
        "leadCoordinator": { "type": "string", "maxLength": 100 },
        "leadContact": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["proposed", "confirmed", "completed", "cancelled"] },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "festId", "title", "category", "date", "startTime", "endTime", "expectedParticipants", "estimatedCost", "ownerId"]
    },
    "BudgetItem": {
      "title": "BudgetItem",
      "description": "Financial allocation line item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "festId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 100 },
        "allocatedAmount": { "type": "number" },
        "spentAmount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "festId", "category", "title", "allocatedAmount", "spentAmount", "ownerId"]
    }
  },
  "firestore": {
    "/fests/{festId}": {
      "schema": "Fest",
      "description": "Master college festival configuration document"
    },
    "/fests/{festId}/venues/{venueId}": {
      "schema": "Venue",
      "description": "Campus venues belonging to a festival"
    },
    "/fests/{festId}/events/{eventId}": {
      "schema": "Event",
      "description": "Festival events scheduled or proposed"
    },
    "/fests/{festId}/budgetItems/{itemId}": {
      "schema": "BudgetItem",
      "description": "Granular festival budget allocation and expenses"
    }
  }
}
